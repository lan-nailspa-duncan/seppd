         cJSON_Delete(root);
         return n32c_send_json_response(msg,
                                        400,
@@ -765,7 +835,10 @@ static int n32c_handle_exchange_capability_response(
     snprintf(peer->n32f_peer_fqdn, sizeof(peer->n32f_peer_fqdn), "%s",
              sender_n32f_fqdn ? sender_n32f_fqdn->valuestring
                               : peer->n32c_peer_fqdn);
-    peer->n32f_peer_port = peer->n32c_peer_port;
