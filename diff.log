                                            const char *capability)
 {
@@ -328,6 +374,11 @@ static char *n32c_build_capability_request(const struct sepp_context *ctx,
         return NULL;
     }
 
+    if (n32c_add_local_plmn_list(ctx, root) != 0) {
+        cJSON_Delete(root);
+        return NULL;
+    }
+
     body = cJSON_PrintUnformatted(root);
     cJSON_Delete(root);
     return body;
@@ -407,6 +458,12 @@ static char *n32c_build_capability_response(const struct sepp_context *ctx,
